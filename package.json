{
  "name": "psd-view",
  "version": "0.1.0",
  "description": "PSD VIEW - explorer offline e rápido para PSD, imagens, PDFs e vídeos",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "icons": "powershell -ExecutionPolicy Bypass -File build/make-icons.ps1",
    "dist": "powershell -ExecutionPolicy Bypass -File build/build-and-sign.ps1"
  },
  "author": "Cristiano Violla",
  "license": "UNLICENSED",
  "dependencies": {
    "ag-psd": "^28.0.0",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "electronVersion": "33.4.11",
    "appId": "br.com.cviolla.psdview",
    "productName": "PSD VIEW",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "icons/**/*",
      "build/icon.png",
      "build/favicon.png",
      "LOGO.png",
      "gilroy-*.ttf",
      "gilroy-*.otf",
      "Gilroy-*.ttf",
      "Gilroy-*.otf",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": ["portable"]
    },
    "portable": {
      "artifactName": "PSD-VIEW-${version}-portable.exe"
    }
  }
}
